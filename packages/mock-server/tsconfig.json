{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": "..",
    "sourceMap": true,
    "declaration": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": false,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "strict": true,
    "useDefineForClassFields": false,
    "target": "ES2022",
    "lib": [
      "esnext"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "paths": {},
    "module": "ESNext",
    "moduleResolution": "Node"
  }
}